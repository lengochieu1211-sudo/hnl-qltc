diff --git a/src/utils/chatUnread.ts b/src/utils/chatUnread.ts
new file mode 100644
index 0000000..f895486
--- /dev/null
+++ b/src/utils/chatUnread.ts
@@ -0,0 +1,16 @@
+/** Project chat unread badge: message counts are authoritative when present.
+ * Server timestamps are a fallback ONLY for pre-count legacy records.
+ * Do not combine both via `||`: Firestore serverTimestamp() can be later than
+ * the last sent timestamp even when all messages have been read. */
+export function getChatUnreadCount(
+  totalCount: number | null | undefined,
+  lastReadCount: number | null | undefined,
+  lastMessageAt: number,
+  lastReadAt: number,
+): number {
+  if (typeof totalCount === 'number' && typeof lastReadCount === 'number' && Number.isFinite(totalCount) && Number.isFinite(lastReadCount) && totalCount >= 0 && lastReadCount >= 0) {
+    return Math.max(0, Math.trunc(totalCount) - Math.trunc(lastReadCount));
+  }
+  // Missing or malformed counters on legacy docs: use timestamps conservatively.
+  return lastMessageAt > 0 && lastMessageAt > lastReadAt ? 1 : 0;
+}
diff --git a/src/utils/roomHighlightSnap.ts b/src/utils/roomHighlightSnap.ts
new file mode 100644
index 0000000..1e45f1c
--- /dev/null
+++ b/src/utils/roomHighlightSnap.ts
@@ -0,0 +1,26 @@
+import type { Point2D } from '../types';
+
+/** Optional pixel-tolerance orthogonal snap for polygon creation / vertex edits.
+ * Works in percentage map coordinates, but measures tolerance in actual viewport pixels,
+ * so zoom does not change user-visible snap distance. Already-saved geometry is untouched. */
+export function snapRoomPointOrthogonal(
+  point: Point2D,
+  nearby: readonly Point2D[],
+  viewport: { width: number; height: number },
+  options: { disabled?: boolean; tolerancePx?: number } = {},
+): Point2D {
+  if (options.disabled || nearby.length === 0) return point;
+  const width = Math.max(1, viewport.width);
+  const height = Math.max(1, viewport.height);
+  const tolerance = Math.max(0, options.tolerancePx ?? 8);
+  const x = nearby.map((p) => ({ value: p.x, delta: Math.abs(p.x - point.x) * width / 100, anchor: p }))
+    .filter((p) => p.delta <= tolerance).sort((a, b) => a.delta - b.delta)[0];
+  const y = nearby.map((p) => ({ value: p.y, delta: Math.abs(p.y - point.y) * height / 100, anchor: p }))
+    .filter((p) => p.delta <= tolerance).sort((a, b) => a.delta - b.delta)[0];
+  // Avoid snapping a new polygon point onto its existing neighbouring vertex:
+  // that would create a zero-length edge or collapse a shape.
+  if (x && y && x.anchor === y.anchor) {
+    return x.delta <= y.delta ? { ...point, x: x.value } : { ...point, y: y.value };
+  }
+  return { x: x ? x.value : point.x, y: y ? y.value : point.y };
+}
