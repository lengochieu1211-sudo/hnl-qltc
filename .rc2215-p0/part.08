+      level: 'error',
+      area: 'unhandled-rejection',
+      code: 'UNHANDLED_REJECTION',
+      message: reason instanceof Error ? `${reason.name}: ${reason.message}` : String(reason || 'Unknown rejection'),
+    });
+  });
+}
