rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isGoogleAuthed() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email is string;
    }

    function signedInEmail() {
      return request.auth.token.email.lower();
    }

    function projectDoc(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId));
    }

    function isOwner(projectId) {
      return isGoogleAuthed() && (
        projectDoc(projectId).data.ownerUid == request.auth.uid ||
        (projectDoc(projectId).data.ownerEmail is string && projectDoc(projectId).data.ownerEmail.lower() == signedInEmail())
      );
    }

    function hasUidMember(projectId) {
      return isGoogleAuthed() && exists(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid));
    }

    function hasEmailMember(projectId) {
      return isGoogleAuthed() && exists(/databases/$(database)/documents/projects/$(projectId)/members/$(signedInEmail()));
    }

    function uidRole(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid)).data.role;
    }

    function emailRole(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)/members/$(signedInEmail())).data.role;
    }

    function uidMemberActive(projectId) {
      return hasUidMember(projectId) && (
        !('active' in get(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid)).data)
        || get(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid)).data.active != false
      );
    }

    function emailMemberActive(projectId) {
      return hasEmailMember(projectId) && (
        !('active' in get(/databases/$(database)/documents/projects/$(projectId)/members/$(signedInEmail())).data)
        || get(/databases/$(database)/documents/projects/$(projectId)/members/$(signedInEmail())).data.active != false
      );
    }

    function isMember(projectId) {
      return isGoogleAuthed() && (isOwner(projectId) || uidMemberActive(projectId) || emailMemberActive(projectId));
    }

    function isAdmin(projectId) {
      return isGoogleAuthed() && (
        isOwner(projectId) ||
        (uidMemberActive(projectId) && uidRole(projectId) == 'ADMIN') ||
        (emailMemberActive(projectId) && emailRole(projectId) == 'ADMIN')
      );
    }

    function canEdit(projectId) {
      return isGoogleAuthed() && (
        isAdmin(projectId) ||
        (uidMemberActive(projectId) && uidRole(projectId) == 'ENGINEER') ||
        (emailMemberActive(projectId) && emailRole(projectId) == 'ENGINEER')
      );
    }

    function canReadAudit(projectId) {
      return isAdmin(projectId) || canEdit(projectId);
    }

    function canRecoverOwnerUid(projectId) {
      return isGoogleAuthed()
        && projectDoc(projectId).data.ownerEmail is string
        && projectDoc(projectId).data.ownerEmail.lower() == signedInEmail()
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid', 'updatedAt']);
    }

    function canClaimOrphanProject(projectId) {
      return isGoogleAuthed()
        && (!('ownerUid' in resource.data) || resource.data.ownerUid == null || resource.data.ownerUid == '')
        && (!('ownerEmail' in resource.data) || resource.data.ownerEmail == null || resource.data.ownerEmail == '')
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail is string
        && request.resource.data.ownerEmail.lower() == signedInEmail()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid', 'ownerEmail', 'updatedAt']);
    }

    match /projects/{projectId} {
      allow read: if isMember(projectId) || (
        isGoogleAuthed() && resource.data.ownerUid == request.auth.uid
      );

      allow create: if isGoogleAuthed()
        && request.resource.data.id == projectId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail is string
        && request.resource.data.ownerEmail.lower() == signedInEmail()
        && ('createdAt' in request.resource.data);

      // createdAt is immutable after the first Cloud write. Legacy documents that
      // do not have the field may add it exactly once during the V6.1.3 migration.
      allow update: if (
          (isAdmin(projectId)
            && request.resource.data.ownerUid == resource.data.ownerUid
            && request.resource.data.ownerEmail == resource.data.ownerEmail)
          || canRecoverOwnerUid(projectId)
          || canClaimOrphanProject(projectId)
        )
        && (
          (('createdAt' in resource.data) && ('createdAt' in request.resource.data)
            && request.resource.data.createdAt == resource.data.createdAt)
          || (!('createdAt' in resource.data) && ('createdAt' in request.resource.data))
        );

      allow delete: if isOwner(projectId);

      match /members/{memberId} {
        allow read: if isMember(projectId)
          || (isGoogleAuthed() && memberId == request.auth.uid)
          || (isGoogleAuthed() && memberId == signedInEmail());

        // ADMIN manages membership. An invited user may only materialize/update their own
        // UID member document when an active email-member already exists, and the role
        // must exactly match that email member. This prevents self role escalation while
        // making email invitations durable across devices.
        allow create, update: if isAdmin(projectId) || (
          isGoogleAuthed()
          && memberId == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email is string
          && request.resource.data.email == signedInEmail()
          && emailMemberActive(projectId)
          && request.resource.data.role == emailRole(projectId)
          && request.resource.data.active != false
        );
        allow delete: if isAdmin(projectId);
      }

      // Append-only, identity-bound audit stream. This path is intentionally
      // excluded from the generic project-data rule below.
      match /activityLogs/{logId} {
        allow read: if canReadAudit(projectId);
        allow create: if canEdit(projectId)
          && request.resource.data.projectId == projectId
          && request.resource.data.userUid == request.auth.uid
          && request.resource.data.userEmail is string
          && request.resource.data.userEmail.lower() == signedInEmail()
          && request.resource.data.deviceId is string
          && request.resource.data.action is string
          && request.resource.data.clientTimestamp is number;
        allow update, delete: if false;
      }

      // Project chat is deliberately separated from construction records. VIEWER may chat,
      // but every message is identity-bound and hard delete is disabled.
      match /conversations/{conversationId} {
        allow read: if isMember(projectId);
        // Conversation summary is written only as part of sending a message. Keep
        // identity/project fields bound and require messageCount to move forward by
        // exactly one so a modified client cannot arbitrarily clear/inflate unread state.
        allow create: if isMember(projectId)
          && request.resource.data.projectId == projectId
          && request.resource.data.id == conversationId
          && request.resource.data.lastSenderUid == request.auth.uid
          && request.resource.data.lastMessageAt == request.time
          && request.resource.data.messageCount == 1;
        allow update: if isMember(projectId)
          && request.resource.data.projectId == resource.data.projectId
          && request.resource.data.id == resource.data.id
          && request.resource.data.lastSenderUid == request.auth.uid
          && request.resource.data.lastMessageAt == request.time
          && (
            (!('messageCount' in resource.data) && request.resource.data.messageCount == 1)
            || (('messageCount' in resource.data) && request.resource.data.messageCount == resource.data.messageCount + 1)
          );
        allow delete: if false;

        match /messages/{messageId} {
          allow read: if isMember(projectId);
          allow create: if isMember(projectId)
            && request.resource.data.projectId == projectId
            && request.resource.data.conversationId == conversationId
            && request.resource.data.senderUid == request.auth.uid
            && request.resource.data.senderEmail is string
            && request.resource.data.senderEmail.lower() == signedInEmail()
            && request.resource.data.clientMessageId is string
            && request.resource.data.createdAt == request.time
            && (!(request.resource.data.mentions is list) || !('everyone' in request.resource.data.mentions) || isAdmin(projectId));
          allow update: if isMember(projectId)
            && resource.data.senderUid == request.auth.uid
            && request.resource.data.senderUid == resource.data.senderUid
            && request.resource.data.senderEmail == resource.data.senderEmail
            && request.resource.data.projectId == resource.data.projectId
            && request.resource.data.conversationId == resource.data.conversationId
            && request.resource.data.clientMessageId == resource.data.clientMessageId
            && request.resource.data.createdAt == resource.data.createdAt
            && (!(request.resource.data.mentions is list) || !('everyone' in request.resource.data.mentions) || isAdmin(projectId));
          allow delete: if false;
        }

        match /members/{uid} {
          allow read: if isMember(projectId);
          allow create, update: if isMember(projectId)
            && uid == request.auth.uid
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.projectId == projectId
            && request.resource.data.conversationId == conversationId;
          allow delete: if uid == request.auth.uid;
        }
      }

      // Business records: VIEWER reads only; ENGINEER/ADMIN may create/update/delete.
      // activityLogs, members and conversations have their own stricter rules above.
      match /{collectionName}/{recordId} {
        allow read: if collectionName != 'activityLogs' && collectionName != 'members' && collectionName != 'conversations' && isMember(projectId);
        allow write: if collectionName != 'activityLogs' && collectionName != 'members' && collectionName != 'conversations' && canEdit(projectId);

        // Compatibility for photo binary chunks used only when Primary Drive is unavailable.
        match /{nestedCollection}/{nestedId} {
          allow read: if isMember(projectId);
          allow write: if canEdit(projectId);
        }
      }
    }

    // Primary Drive Bridge endpoint/config is readable to authenticated clients,
    // but only the designated Drive owner can change it.
    match /app_config/{configId} {
      allow read: if isGoogleAuthed();
      allow create, update, delete: if isGoogleAuthed() && signedInEmail() == 'lengochieu1211@gmail.com';
    }

    // Durable discovery index. It does NOT grant project access; project reads still
    // require projects/{projectId}/members or owner checks above. The signed-in user can
    // only read index rows for their own email; project ADMINs maintain the rows.
    match /projectAccess/{accessId} {
      allow read: if isGoogleAuthed() && (
        (resource.data.email is string && resource.data.email == signedInEmail())
        || isAdmin(resource.data.projectId)
      );
      allow create: if isGoogleAuthed()
        && request.resource.data.projectId is string
        && request.resource.data.email is string
        && isAdmin(request.resource.data.projectId);
      allow update: if isGoogleAuthed()
        && resource.data.projectId == request.resource.data.projectId
        && resource.data.email == request.resource.data.email
        && isAdmin(resource.data.projectId);
      allow delete: if isGoogleAuthed() && isAdmin(resource.data.projectId);
    }

    match /users/{userId} {
      allow read, create, update: if isGoogleAuthed() && request.auth.uid == userId;
      allow delete: if false;

      match /devices/{deviceId} {
        allow read, create, update: if isGoogleAuthed() && request.auth.uid == userId
          && request.resource.data.deviceId == deviceId;
        allow delete: if isGoogleAuthed() && request.auth.uid == userId;
      }
    }

    match /projectInvitations/{invitationId} {
      allow read: if isGoogleAuthed() && (
        (resource.data.invitedEmail is string && resource.data.invitedEmail.lower() == signedInEmail()) ||
        (resource.data.email is string && resource.data.email.lower() == signedInEmail()) ||
        resource.data.createdByUid == request.auth.uid ||
        isMember(resource.data.projectId)
      );
      allow create: if isGoogleAuthed() && isAdmin(request.resource.data.projectId);
      allow update, delete: if isGoogleAuthed() && (
        isAdmin(resource.data.projectId) ||
        (resource.data.invitedEmail is string && resource.data.invitedEmail.lower() == signedInEmail()) ||
        (resource.data.email is string && resource.data.email.lower() == signedInEmail())
      );
    }

    match /cloud_backups/{backupId} {
      allow read, delete: if isGoogleAuthed() && resource.data.ownerUid == request.auth.uid;
      allow create: if isGoogleAuthed() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isGoogleAuthed()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
    }
  }
}
