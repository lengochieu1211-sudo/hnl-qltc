rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isGoogleAuthed() {
      // Firebase Auth is the identity source. Production currently enables Google sign-in;
      // rules intentionally bind authorization to verified Firebase identity + membership,
      // not to a browser/provider-specific UI path. This also makes emulator rules tests real.
      return request.auth != null && request.auth.token.email is string;
    }

    function signedInEmail() {
      return request.auth.token.email.lower();
    }

    // Company-wide SUPER ADMIN. This account can discover/read/manage every project
    // without being materialized into each project's members collection. Project owner
    // identity remains immutable through the project update rule below.
    function isSuperAdmin() {
      return isGoogleAuthed() && signedInEmail() == 'lengochieu1211@gmail.com';
    }

    function projectExists(projectId) {
      return exists(/databases/$(database)/documents/projects/$(projectId));
    }

    function projectDoc(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId));
    }

    // Never dereference projectDoc(...).data for a missing project root. A fresh
    // Firebase-only/Emulator project is intentionally allowed to be absent until
    // its first authenticated owner claim creates the root document.
    function isOwner(projectId) {
      return isGoogleAuthed()
        && projectExists(projectId)
        && (
          (('ownerUid' in projectDoc(projectId).data) && projectDoc(projectId).data.ownerUid == request.auth.uid) ||
          (('ownerEmail' in projectDoc(projectId).data)
            && projectDoc(projectId).data.ownerEmail is string
            && projectDoc(projectId).data.ownerEmail.lower() == signedInEmail())
        );
    }

    function hasUidMember(projectId) {
      return isGoogleAuthed() && exists(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid));
    }

    function hasEmailMember(projectId) {
      return isGoogleAuthed() && exists(/databases/$(database)/documents/projects/$(projectId)/members/$(signedInEmail()));
    }

    function uidRole(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid)).data.role;
    }

    function emailRole(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)/members/$(signedInEmail())).data.role;
    }

    function uidMemberActive(projectId) {
      return hasUidMember(projectId) && (
        !('active' in get(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid)).data)
        || get(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid)).data.active != false
      );
    }

    function emailMemberActive(projectId) {
      return hasEmailMember(projectId) && (
        !('active' in get(/databases/$(database)/documents/projects/$(projectId)/members/$(signedInEmail())).data)
        || get(/databases/$(database)/documents/projects/$(projectId)/members/$(signedInEmail())).data.active != false
      );
    }

    // Canonical membership invariant: if an email document exists it is the single
    // authoritative role, including active=false revocation. UID is fallback only for
    // legacy projects that have not materialized a canonical email document yet.
    function canonicalMemberActive(projectId) {
      return hasEmailMember(projectId) ? emailMemberActive(projectId) : uidMemberActive(projectId);
    }

    function canonicalMemberRole(projectId) {
      return hasEmailMember(projectId) ? emailRole(projectId) : uidRole(projectId);
    }

    function isMember(projectId) {
      return isGoogleAuthed() && (isSuperAdmin() || isOwner(projectId) || canonicalMemberActive(projectId));
    }

    function isAdmin(projectId) {
      return isGoogleAuthed() && (
        isSuperAdmin() ||
        isOwner(projectId) ||
        (canonicalMemberActive(projectId) && canonicalMemberRole(projectId) == 'ADMIN')
      );
    }

    function isEditor(projectId) {
      return isGoogleAuthed()
        && canonicalMemberActive(projectId)
        && (canonicalMemberRole(projectId) == 'EDITOR' || canonicalMemberRole(projectId) == 'ENGINEER');
    }

    function canEdit(projectId) {
      return isAdmin(projectId) || isEditor(projectId);
    }

    function canReadAudit(projectId) {
      return isAdmin(projectId) || canEdit(projectId);
    }

    // RC2.2.5 Master RBAC: EDITOR writes are operational-only and may never
    // create/restore/delete structural business records through lifecycle fields.
    function editorCreatesActiveOnly() {
      return (!('deleted' in request.resource.data) || request.resource.data.deleted != true)
        && (!('deletedAt' in request.resource.data) || request.resource.data.deletedAt == null)
        && (!('deletedByUid' in request.resource.data) || request.resource.data.deletedByUid == null || request.resource.data.deletedByUid == '')
        && (!('deletedBy' in request.resource.data) || request.resource.data.deletedBy == null || request.resource.data.deletedBy == '');
    }

    function editorKeepsActiveLifecycle() {
      return (!('deleted' in resource.data) || resource.data.deleted != true)
        && (!('deletedAt' in resource.data) || resource.data.deletedAt == null)
        && (!('deleted' in request.resource.data) || request.resource.data.deleted != true)
        && (!('deletedAt' in request.resource.data) || request.resource.data.deletedAt == null)
        && (!('deletedByUid' in request.resource.data) || request.resource.data.deletedByUid == null || request.resource.data.deletedByUid == '')
        && (!('deletedBy' in request.resource.data) || request.resource.data.deletedBy == null || request.resource.data.deletedBy == '');
    }

    // Room geometry/identity is ADMIN-owned project structure. EDITOR may update
    // field progress, assignment, inspection and due-date data on an existing room.
    function editorRoomOperationalUpdateOnly() {
      return editorKeepsActiveLifecycle()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'frameStatus', 'boardStatus', 'frameInspectionStatus', 'boardInspectionStatus',
          'inspectionStatus', 'inspectorName', 'notes', 'assignedTeam', 'teamId',
          'targetFrameDate', 'targetBoardDate', 'subItems',
          'deleted', 'deletedAt', 'deletedByUid', 'deletedBy',
          'updatedAt', 'updatedByUid', 'updatedByEmail', 'updatedByDeviceId',
          'updatedByDeviceName', 'revision'
        ]);
    }

    // Checklist definition (floor/category/title/due-date/room binding) belongs to
    // ADMIN. EDITOR can record only inspection outcome, note and inspector.
    function editorChecklistOperationalUpdateOnly() {
      return editorKeepsActiveLifecycle()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'notes', 'inspectedBy', 'inspectedAt',
          'deleted', 'deletedAt', 'deletedByUid', 'deletedBy',
          'updatedAt', 'updatedByUid', 'updatedByEmail', 'updatedByDeviceId',
          'updatedByDeviceName', 'revision'
        ]);
    }

    function isAdminOwnedStructureCollection(name) {
      return name == 'work_volumes'
        || name == 'floor_plans'
        || name == 'rooms'
        || name == 'material_norms'
        || name == 'teams'
        || name == 'checklist'
        || name == 'settings'
        || name == 'trash';
    }

    // Legacy Firestore floor-plan image metadata/chunks are migration fallback only.
    // New binaries belong in Firebase Storage; no client may recreate or mutate the
    // old metadata path. ADMIN may purge it after migration parity is verified.
    function isLegacyReadOnlyCollection(name) {
      return name == 'floor_plan_images';
    }

    // Fail closed for EDITOR: only explicitly known field-operation collections may
    // be created/updated generically. Any future project subcollection starts ADMIN-only
    // until it receives an intentional RBAC classification and regression test.
    function isEditorOperationalCollection(name) {
      return name == 'inventory'
        || name == 'defects'
        || name == 'crew_records';
    }


    function isCanonicalMemberRole(role) {
      return role == 'ADMIN' || role == 'EDITOR' || role == 'VIEWER';
    }

    function isLegacyCompatibleMemberRole(role) {
      return isCanonicalMemberRole(role) || role == 'ENGINEER';
    }

    function coreCreateLifecycleIsValid(recordId) {
      return request.resource.data.id == recordId
        && (!('revision' in request.resource.data) || request.resource.data.revision >= 1)
        && (!('deleted' in request.resource.data) || request.resource.data.deleted != true
          || (('deletedAt' in request.resource.data) && request.resource.data.deletedAt != null))
        && (!('deletedAt' in request.resource.data) || request.resource.data.deletedAt == null
          || (('deleted' in request.resource.data) && request.resource.data.deleted == true));
    }

    function isCoreBusinessCollection(name) {
      return name == 'rooms'
        || name == 'inventory'
        || name == 'defects'
        || name == 'work_volumes'
        || name == 'floor_plans'
        || name == 'checklist'
        || name == 'crew_records'
        || name == 'teams'
        || name == 'material_norms'
        || name == 'photos';
    }

    function coreIdentityUpdateIsValid(recordId) {
      return request.resource.data.id == recordId
        && (!('id' in resource.data) || resource.data.id == recordId);
    }

    function lifecycleUpdateIsMonotonic() {
      // Once a record participates in lifecycle/revision control, clients may not
      // escape the guard by omitting those fields. Legacy records without revision
      // are allowed one migration update that introduces revision >= 1.
      return (!('updatedAt' in resource.data) || (('updatedAt' in request.resource.data) && request.resource.data.updatedAt >= resource.data.updatedAt))
        && (!('revision' in resource.data) || (('revision' in request.resource.data) && request.resource.data.revision > resource.data.revision))
        && (!('revision' in request.resource.data) || request.resource.data.revision >= 1)
        && (!('deleted' in request.resource.data) || request.resource.data.deleted != true || (('deletedAt' in request.resource.data) && request.resource.data.deletedAt != null));
    }

    function canRecoverOwnerUid(projectId) {
      return isGoogleAuthed()
        && projectExists(projectId)
        && ('ownerEmail' in projectDoc(projectId).data)
        && projectDoc(projectId).data.ownerEmail is string
        && projectDoc(projectId).data.ownerEmail.lower() == signedInEmail()
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid', 'updatedAt']);
    }

    function canClaimOrphanProject(projectId) {
      return isGoogleAuthed()
        && (!('ownerUid' in resource.data) || resource.data.ownerUid == null || resource.data.ownerUid == '')
        && (!('ownerEmail' in resource.data) || resource.data.ownerEmail == null || resource.data.ownerEmail == '')
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail is string
        && request.resource.data.ownerEmail.lower() == signedInEmail()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid', 'ownerEmail', 'updatedAt']);
    }

    // V6.2.26: Some very old project roots predate ownerUid/ownerEmail AND createdAt.
    // A SUPER ADMIN must still be able to move those roots into/out of the project trash,
    // but this exception is deliberately limited to trash metadata only. It cannot rewrite
    // ownership, project business fields, or project identity.
    function canSuperAdminTrashLegacyProject(projectId) {
      return isSuperAdmin()
        && !('createdAt' in resource.data)
        && !('createdAt' in request.resource.data)
        && (!('id' in resource.data) || resource.data.id == projectId)
        && request.resource.data.id == projectId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'id',
          'deleted',
          'deletedAt',
          'trashRetentionDays',
          'trashExpiresAt',
          'updatedAt'
        ]);
    }


    match /projects/{projectId} {
      // A signed-in client may probe a missing root so claimProjectOwnership() can
      // distinguish "not created yet" from "permission denied" and then use the
      // strict create rule below. Existing project data remains membership/owner gated.
      allow read: if (
        isGoogleAuthed() && !projectExists(projectId)
      ) || isMember(projectId) || (
        isGoogleAuthed()
        && ('ownerUid' in resource.data)
        && resource.data.ownerUid == request.auth.uid
      );

      allow create: if isGoogleAuthed()
        && request.resource.data.id == projectId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail is string
        && request.resource.data.ownerEmail.lower() == signedInEmail()
        && ('createdAt' in request.resource.data);

      // createdAt is immutable after the first Cloud write. Legacy documents that
      // do not have the field may add it exactly once during the V6.1.3 migration.
      // V6.2.26 adds one narrow exception: SUPER ADMIN may soft-delete/restore a root
      // that still has no createdAt, but only by changing the trash metadata allow-list.
      allow update: if (
        (
          (
            // SUPER ADMIN may maintain legacy projects, but may never use that access
            // to rewrite project ownership.
            (isSuperAdmin()
              && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerUid', 'ownerEmail']))
            || (isAdmin(projectId)
              && !isSuperAdmin()
              && request.resource.data.ownerUid == resource.data.ownerUid
              && request.resource.data.ownerEmail == resource.data.ownerEmail)
            || canRecoverOwnerUid(projectId)
            || canClaimOrphanProject(projectId)
          )
          && (
            (('createdAt' in resource.data) && ('createdAt' in request.resource.data)
              && request.resource.data.createdAt == resource.data.createdAt)
            || (!('createdAt' in resource.data) && ('createdAt' in request.resource.data))
          )
        )
        || canSuperAdminTrashLegacyProject(projectId)
      );

      // Firebase-only project deletion is soft-delete only; physical purge is an explicit
      // administrative migration/retention operation, never a normal client action.
      allow delete: if false;

      match /members/{memberId} {
        allow read: if isMember(projectId)
          || (isGoogleAuthed() && memberId == request.auth.uid)
          || (isGoogleAuthed() && memberId == signedInEmail());

        // ADMIN manages membership. An invited user may only materialize/update their own
        // UID member document when an active email-member already exists, and the role
        // must exactly match that email member. This prevents self role escalation while
        // making email invitations durable across devices.
        allow create, update: if (
          isAdmin(projectId)
          && request.resource.data.role is string
          && isCanonicalMemberRole(request.resource.data.role)
        ) || (
          isGoogleAuthed()
          && memberId == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email is string
          && request.resource.data.email == signedInEmail()
          && emailMemberActive(projectId)
          && request.resource.data.role == emailRole(projectId)
          && isLegacyCompatibleMemberRole(request.resource.data.role)
          && request.resource.data.active != false
        );
        allow delete: if isAdmin(projectId);
      }

      // Append-only, identity-bound audit stream. This path is intentionally
      // excluded from the generic project-data rule below.
      match /activityLogs/{logId} {
        allow read: if canReadAudit(projectId);
        allow create: if canEdit(projectId)
          && request.resource.data.projectId == projectId
          && request.resource.data.userUid == request.auth.uid
          && request.resource.data.userEmail is string
          && request.resource.data.userEmail.lower() == signedInEmail()
          && request.resource.data.deviceId is string
          && request.resource.data.action is string
          && request.resource.data.clientTimestamp is number;
        allow update, delete: if false;
      }

      // Project chat is deliberately separated from construction records. VIEWER may chat,
      // but every message is identity-bound and hard delete is disabled.
      match /conversations/{conversationId} {
        allow read: if isMember(projectId);
        // Conversation summary is written only as part of sending a message. Keep
        // identity/project fields bound and require messageCount to move forward by
        // exactly one so a modified client cannot arbitrarily clear/inflate unread state.
        allow create: if isMember(projectId)
          && request.resource.data.projectId == projectId
          && request.resource.data.id == conversationId
          && request.resource.data.lastSenderUid == request.auth.uid
          && request.resource.data.lastMessageAt == request.time
          && request.resource.data.messageCount == 1;
        allow update: if isMember(projectId)
          && request.resource.data.projectId == resource.data.projectId
          && request.resource.data.id == resource.data.id
          && request.resource.data.lastSenderUid == request.auth.uid
          && request.resource.data.lastMessageAt == request.time
          && (
            (!('messageCount' in resource.data) && request.resource.data.messageCount == 1)
            || (('messageCount' in resource.data) && request.resource.data.messageCount == resource.data.messageCount + 1)
          );
        allow delete: if false;

        match /messages/{messageId} {
          allow read: if isMember(projectId);
          allow create: if isMember(projectId)
            && request.resource.data.projectId == projectId
            && request.resource.data.conversationId == conversationId
            && request.resource.data.senderUid == request.auth.uid
            && request.resource.data.senderEmail is string
            && request.resource.data.senderEmail.lower() == signedInEmail()
            && request.resource.data.clientMessageId is string
            && request.resource.data.createdAt == request.time
            && (!(request.resource.data.mentions is list) || !('everyone' in request.resource.data.mentions) || isAdmin(projectId));
          allow update: if isMember(projectId)
            && resource.data.senderUid == request.auth.uid
            && request.resource.data.senderUid == resource.data.senderUid
            && request.resource.data.senderEmail == resource.data.senderEmail
            && request.resource.data.projectId == resource.data.projectId
            && request.resource.data.conversationId == resource.data.conversationId
            && request.resource.data.clientMessageId == resource.data.clientMessageId
            && request.resource.data.createdAt == resource.data.createdAt
            && (!(request.resource.data.mentions is list) || !('everyone' in request.resource.data.mentions) || isAdmin(projectId));
          allow delete: if false;
        }

        match /members/{uid} {
          allow read: if isMember(projectId);
          allow create, update: if isMember(projectId)
            && uid == request.auth.uid
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.projectId == projectId
            && request.resource.data.conversationId == conversationId;
          allow delete: if uid == request.auth.uid;
        }
      }

      // Derived warehouse balances. Inventory transaction rows remain the ledger/source;
      // this aggregate exists only for online atomic stock validation and fast reads.
      // Clients may read it, but normal generic autosave cannot hard-delete it.
      match /inventory_balances/{balanceId} {
        allow read: if isMember(projectId);
        allow create: if canEdit(projectId)
          && request.resource.data.id == balanceId
          && request.resource.data.projectId == projectId
          && request.resource.data.onHand is number
          && request.resource.data.onHand >= 0
          && request.resource.data.revision >= 1;
        allow update: if canEdit(projectId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.projectId == resource.data.projectId
          && request.resource.data.onHand is number
          && request.resource.data.onHand >= 0
          && request.resource.data.revision > resource.data.revision
          && request.resource.data.updatedAt >= resource.data.updatedAt;
        allow delete: if false;
      }

      // V6.3.0 Firebase-only business lifecycle. VIEWER reads only; EDITOR/ADMIN edit.
      // ENGINEER remains accepted as a temporary legacy alias for deployed member docs.
      // Core business records are soft-delete only and reject stale revision/updatedAt
      // overwrites. Shared settings/trash metadata are ADMIN-owned structure; legacy
      // floor_plan_images Firestore fallback is read-only until verified purge.
      match /{collectionName}/{recordId} {
        allow read: if collectionName != 'activityLogs' && collectionName != 'members' && collectionName != 'conversations' && collectionName != 'inventory_balances' && isMember(projectId);
        // Master project structure is ADMIN-only. EDITOR may create operational records
        // (defect, warehouse transaction, crew log, photo metadata) and may update only
        // explicitly allowed operational fields on rooms/checklist. VIEWER remains read-only.
        allow create: if collectionName != 'activityLogs' && collectionName != 'members' && collectionName != 'conversations' && collectionName != 'inventory_balances'
          && !isLegacyReadOnlyCollection(collectionName)
          && (
            isAdmin(projectId)
            || (isEditor(projectId) && (
              (collectionName == 'photos' && editorCreatesActiveOnly())
              || (isEditorOperationalCollection(collectionName) && editorCreatesActiveOnly())
            ))
          )
          && (!isCoreBusinessCollection(collectionName) || coreCreateLifecycleIsValid(recordId));
        allow update: if collectionName != 'activityLogs' && collectionName != 'members' && collectionName != 'conversations' && collectionName != 'inventory_balances'
          && !isLegacyReadOnlyCollection(collectionName)
          && (
            isAdmin(projectId)
            || (isEditor(projectId) && (
              (collectionName == 'rooms' && editorRoomOperationalUpdateOnly())
              || (collectionName == 'checklist' && editorChecklistOperationalUpdateOnly())
              || collectionName == 'photos'
              || (isEditorOperationalCollection(collectionName) && editorKeepsActiveLifecycle())
            ))
          )
          && (!isCoreBusinessCollection(collectionName) || (coreIdentityUpdateIsValid(recordId) && lifecycleUpdateIsMonotonic()));
        allow delete: if collectionName != 'activityLogs' && collectionName != 'members' && collectionName != 'conversations' && collectionName != 'inventory_balances'
          && isAdmin(projectId)
          && !isCoreBusinessCollection(collectionName);

        // Legacy Firestore binary chunks are read-only during Storage migration. Physical
        // cleanup is ADMIN-only after migration verification; no new chunks may be written.
        match /{nestedCollection}/{nestedId} {
          allow read: if isMember(projectId);
          allow delete: if isAdmin(projectId);
          allow create, update: if false;
        }
      }
    }

    // Primary Drive Bridge endpoint/config is readable to authenticated clients,
    // but only the designated Drive owner can change it.
    match /app_config/{configId} {
      allow read: if isGoogleAuthed();
      allow create, update, delete: if isGoogleAuthed() && signedInEmail() == 'lengochieu1211@gmail.com';
    }

    // Durable discovery index. It does NOT grant project access; project reads still
    // require projects/{projectId}/members or owner checks above. The signed-in user can
    // only read index rows for their own email; project ADMINs maintain the rows.
    match /projectAccess/{accessId} {
      allow read: if isGoogleAuthed() && (
        (resource.data.email is string && resource.data.email == signedInEmail())
        || isAdmin(resource.data.projectId)
      );
      allow create: if isGoogleAuthed()
        && request.resource.data.projectId is string
        && request.resource.data.email is string
        && isAdmin(request.resource.data.projectId);
      allow update: if isGoogleAuthed()
        && resource.data.projectId == request.resource.data.projectId
        && resource.data.email == request.resource.data.email
        && isAdmin(resource.data.projectId);
      allow delete: if isGoogleAuthed() && isAdmin(resource.data.projectId);
    }

    match /users/{userId} {
      allow read, create, update: if isGoogleAuthed() && request.auth.uid == userId;
      allow delete: if false;

      match /devices/{deviceId} {
        allow read, create, update: if isGoogleAuthed() && request.auth.uid == userId
          && request.resource.data.deviceId == deviceId;
        allow delete: if isGoogleAuthed() && request.auth.uid == userId;
      }
    }

    match /projectInvitations/{invitationId} {
      allow read: if isGoogleAuthed() && (
        (resource.data.invitedEmail is string && resource.data.invitedEmail.lower() == signedInEmail()) ||
        (resource.data.email is string && resource.data.email.lower() == signedInEmail()) ||
        resource.data.createdByUid == request.auth.uid ||
        isMember(resource.data.projectId)
      );
      allow create: if isGoogleAuthed() && isAdmin(request.resource.data.projectId);
      allow update, delete: if isGoogleAuthed() && (
        isAdmin(resource.data.projectId) ||
        (resource.data.invitedEmail is string && resource.data.invitedEmail.lower() == signedInEmail()) ||
        (resource.data.email is string && resource.data.email.lower() == signedInEmail())
      );
    }

    match /cloud_backups/{backupId} {
      allow read, delete: if isGoogleAuthed() && resource.data.ownerUid == request.auth.uid;
      allow create: if isGoogleAuthed() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isGoogleAuthed()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
    }
  }
}
