# HNL QLTC DEV MAIN template. Copy to .env.dev-primary.local (git ignored).
# Obtain public SDK config from existing hnl-qltc-dev; never use PROD credentials.
VITE_APP_ENV=DEV
VITE_DEV_FIREBASE_TARGET=primary
VITE_RUNTIME_BACKEND=firebase-only
VITE_FIREBASE_PROJECT_ID=hnl-qltc-dev
VITE_FIREBASE_API_KEY=YOUR_PRIMARY_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=hnl-qltc-dev.firebaseapp.com
VITE_FIREBASE_APP_ID=YOUR_PRIMARY_FIREBASE_WEB_APP_ID
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_PRIMARY_MESSAGING_SENDER_ID
VITE_FIREBASE_STORAGE_BUCKET=hnl-qltc-dev.firebasestorage.app
VITE_FIREBASE_FIRESTORE_DATABASE_ID=(default)
VITE_USE_FIREBASE_EMULATORS=false
VITE_BINARY_STORAGE_PROVIDER=r2
VITE_R2_GATEWAY_URL=https://hnl-qltc-r2-gateway-dev.lengochieu1211.workers.dev
VITE_WAREHOUSE_TRUSTED_WRITER=false
VITE_HNL_AI_ENABLED=false
VITE_HNL_AI_GATEWAY_URL=
VITE_ENABLE_LEGACY_DRIVE_READ=false
VITE_ENABLE_LEGACY_DRIVE_WRITE=false
VITE_ENABLE_LEGACY_LOCAL_BUSINESS_CACHE_WRITE=false
