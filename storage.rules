rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null && request.auth.token.email is string;
    }

    function email() {
      return request.auth.token.email.lower();
    }

    function isSuperAdmin() {
      return signedIn() && email() == 'lengochieu1211@gmail.com';
    }

    function project(projectId) {
      return firestore.get(/databases/(default)/documents/projects/$(projectId));
    }

    function projectActive(projectId) {
      return !('deleted' in project(projectId).data) || project(projectId).data.deleted != true;
    }

    function isOwner(projectId) {
      return signedIn() && (
        project(projectId).data.ownerUid == request.auth.uid ||
        (project(projectId).data.ownerEmail is string && project(projectId).data.ownerEmail.lower() == email())
      );
    }

    function uidMember(projectId) {
      return firestore.get(/databases/(default)/documents/projects/$(projectId)/members/$(request.auth.uid));
    }

    function emailMember(projectId) {
      return firestore.get(/databases/(default)/documents/projects/$(projectId)/members/$(email()));
    }

    function uidMemberExists(projectId) {
      return firestore.exists(/databases/(default)/documents/projects/$(projectId)/members/$(request.auth.uid));
    }

    function emailMemberExists(projectId) {
      return firestore.exists(/databases/(default)/documents/projects/$(projectId)/members/$(email()));
    }

    function uidMemberActive(projectId) {
      return uidMemberExists(projectId) && (!('active' in uidMember(projectId).data) || uidMember(projectId).data.active != false);
    }

    function emailMemberActive(projectId) {
      return emailMemberExists(projectId) && (!('active' in emailMember(projectId).data) || emailMember(projectId).data.active != false);
    }

    function canonicalMemberActive(projectId) {
      return emailMemberExists(projectId) ? emailMemberActive(projectId) : uidMemberActive(projectId);
    }

    function canonicalMemberRole(projectId) {
      return emailMemberExists(projectId) ? emailMember(projectId).data.role : uidMember(projectId).data.role;
    }

    function isMember(projectId) {
      return signedIn() && projectActive(projectId)
        && (isSuperAdmin() || isOwner(projectId) || canonicalMemberActive(projectId));
    }

    function roleCanEdit(role) {
      return role == 'ADMIN' || role == 'EDITOR' || role == 'ENGINEER';
    }

    function isAdmin(projectId) {
      return signedIn() && (
        isSuperAdmin() ||
        isOwner(projectId) ||
        (canonicalMemberActive(projectId) && canonicalMemberRole(projectId) == 'ADMIN')
      );
    }

    function canEdit(projectId) {
      return signedIn() && projectActive(projectId) && (
        isAdmin(projectId) ||
        (canonicalMemberActive(projectId) && roleCanEdit(canonicalMemberRole(projectId)))
      );
    }

    function validSize(fileName) {
      // Thumbnails stay small; originals/PDF attachments use a defensive 25 MiB cap.
      return request.resource.size > 0
        && (fileName.matches('thumb\\..*') ? request.resource.size < 3 * 1024 * 1024 : request.resource.size < 25 * 1024 * 1024);
    }

    function validContentType() {
      return request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf';
    }

    function identityMetadata(projectId, entityType, entityId, assetId) {
      return request.resource.metadata.projectId == projectId
        && request.resource.metadata.entityType == entityType
        && request.resource.metadata.entityId == entityId
        && request.resource.metadata.assetId == assetId
        && request.resource.metadata.createdByUid == request.auth.uid;
    }

    function updateKeepsIdentity(projectId, entityType, entityId, assetId) {
      return resource != null
        && request.resource.metadata.projectId == resource.metadata.projectId
        && request.resource.metadata.entityType == resource.metadata.entityType
        && request.resource.metadata.entityId == resource.metadata.entityId
        && request.resource.metadata.assetId == resource.metadata.assetId
        && request.resource.metadata.createdByUid == resource.metadata.createdByUid
        && request.resource.metadata.projectId == projectId
        && request.resource.metadata.entityType == entityType
        && request.resource.metadata.entityId == entityId
        && request.resource.metadata.assetId == assetId;
    }

    match /projects/{projectId}/media/{entityType}/{entityId}/{assetId}/{fileName} {
      allow read: if isMember(projectId);
      // Production write authority is Cloudflare R2. Firebase Storage is legacy
      // read/purge compatibility only; no new binary may be created or replaced here.
      allow create, update: if false;
      // Normal delete is Firestore soft-delete. Binary purge is ADMIN-only after retention.
      allow delete: if isAdmin(projectId);
    }

    match /projects/{projectId}/floor-plans/{floorPlanId}/{fileName} {
      allow read: if isMember(projectId);
      // Floor-plan drawing binaries are project structure: ADMIN-only.
      allow create, update: if false;
      allow delete: if isAdmin(projectId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
