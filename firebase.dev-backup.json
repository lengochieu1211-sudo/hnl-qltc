{
  "hosting": {
    "site": "hnl-qltc-dev-backup",
    "public": "dist-dev-backup-hosting",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.map",
      "**/*.cjs"
    ],
    "rewrites": [{"source": "**", "destination": "/index.html"}],
    "headers": [
      {"source": "/index.html", "headers": [{"key": "Cache-Control", "value": "no-cache, no-store, must-revalidate"}]},
      {"source": "/hnl-dev-backup-release.json", "headers": [{"key": "Cache-Control", "value": "no-cache, no-store, must-revalidate"}]},
      {"source": "/assets/**", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]}
    ]
  }
}
