# Server-side Google / Gemini config
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GOOGLE_CLIENT_ID="YOUR_GOOGLE_OAUTH_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_OAUTH_CLIENT_SECRET"

# Optional locally. In production the server can usually infer this from the request host.
APP_URL="http://localhost:3000"
PORT="3000"

# Optional server API gate. Leave unset/false for the free static Firebase Hosting deployment.
# Set VITE_API_BASE_URL only after an approved backend exists.
VITE_ENABLE_SERVER_API="false"
VITE_API_BASE_URL=""

# Firebase Web App config. These are injected at build time and must not be committed with real values.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_FIREBASE_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_WEB_APP_ID"
VITE_FIREBASE_MEASUREMENT_ID="YOUR_FIREBASE_MEASUREMENT_ID"
VITE_FIRESTORE_DATABASE_ID="(default)"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"

# Phiên bản ứng dụng dùng cho audit/thiết bị đồng bộ
VITE_APP_VERSION=V6.1.4
