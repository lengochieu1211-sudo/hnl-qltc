<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android selects values-night automatically when the device is using Dark theme.
         Keep the native Activity/WebView in the same system night mode so CSS
         prefers-color-scheme reports "dark" and HNL's existing System theme follows it. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
