{
  "name": "qlct-an-phu",
  "private": true,
  "version": "6.3.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild ./server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist",
    "build:emulator": "node scripts/emulator-dev.mjs build",
    "dev:emulator": "node scripts/emulator-dev.mjs start",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/source-lint.mjs",
    "test:rules": "node scripts/firebase-rules-check.mjs",
    "test:emulator-config": "node scripts/emulator-golden.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=critical",
    "test:stability": "node scripts/stability-gate.mjs && node scripts/offline-golden.mjs && node scripts/category-golden.mjs && node scripts/firebase-only-golden.mjs && node scripts/firebase-only-legacy-audit.mjs --self-test && node scripts/emulator-golden.mjs && node scripts/rbac-matrix.mjs",
    "verify": "npm run test:stability && npm run typecheck && npm run lint && npm run test:rules && npm run security:audit && npm run build",
    "test:offline": "node scripts/offline-golden.mjs",
    "test:category": "node scripts/category-golden.mjs",
    "test:firebase-only": "node scripts/firebase-only-golden.mjs",
    "test:migration-audit": "node scripts/firebase-only-legacy-audit.mjs --self-test",
    "test:rbac": "node scripts/rbac-matrix.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "firebase": "^12.17.1",
    "googleapis": "^174.0.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "localforage": "^1.10.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0"
  }
}
