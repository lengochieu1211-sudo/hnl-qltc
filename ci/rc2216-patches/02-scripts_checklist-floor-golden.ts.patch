+import assert from 'node:assert/strict';
+import { filterChecklistForFloor, isSameChecklistFloor } from '../src/utils/checklistUtils';
+import type { ChecklistItem } from '../src/types';
+
+const item = (id: string, floorName: string, category: string, archivedAt?: string): ChecklistItem => ({
+  id,
+  floorName,
+  category,
+  title: `Checklist ${id}`,
+  status: 'pending',
+  ...(archivedAt ? { archivedAt } : {}),
+});
+
+const data: ChecklistItem[] = [
+  item('a1', 'Tầng 1', 'Khung trần'),
+  item('a2', ' Tầng   1 ', 'Bắn tấm'),
+  item('b1', 'TẦNG 2', 'Khung trần'),
+  item('b2', 'Tầng 2', 'Hoàn thiện'),
+  item('old', 'Tầng 2', 'Cũ', '2026-01-01T00:00:00.000Z'),
+];
+
+assert.equal(isSameChecklistFloor(' Tầng   1 ', 'tầng 1'), true);
+assert.deepEqual(filterChecklistForFloor(data, 'Tầng 1').map((x) => x.id).sort(), ['a1', 'a2']);
+assert.deepEqual(filterChecklistForFloor(data, 'tầng 2').map((x) => x.id).sort(), ['b1', 'b2']);
+assert.deepEqual(filterChecklistForFloor(data, 'Tầng 2', 'Khung trần').map((x) => x.id), ['b1']);
+assert.deepEqual(filterChecklistForFloor(data, 'Tầng 2', 'all').map((x) => x.id).sort(), ['b1', 'b2']);
+
+console.log('Checklist floor/category golden: PASS');
