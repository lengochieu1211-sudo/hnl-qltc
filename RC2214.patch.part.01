+          cache-dependency-path: package-lock.json
+      - name: Install dependencies
+        run: npm ci
+      - name: Stability / Architecture / Golden Gate
+        run: npm run test:stability
+      - name: Typecheck
+        run: npm run typecheck
+      - name: Lint
+        run: npm run lint
+      - name: Firebase Rules compile + emulator behavior
+        run: npm run test:rules
+      - name: Security audit production critical
+        run: npm run security:audit
+      - name: Build PROD bundle
+        run: npm run build
+      - name: R2 gateway health smoke
+        shell: bash
+        run: |
+          set -euo pipefail
+          curl --fail --silent --show-error --retry 3 --max-time 15 "$VITE_R2_GATEWAY_URL/health" | tee /tmp/r2-health.json
+          grep -F 'hnl-qltc-r2-gateway' /tmp/r2-health.json
+      - name: Deploy Firestore rules to existing project
+        shell: bash
+        env:
+          FIREBASE_SERVICE_ACCOUNT: ${{ secrets.FIREBASE_SERVICE_ACCOUNT_COM_EXAMPLE_QLCT_61329 }}
+          GOOGLE_APPLICATION_CREDENTIALS: ${{ runner.temp }}/firebase-service-account.json
+        run: |
+          set -euo pipefail
+          test -n "$FIREBASE_SERVICE_ACCOUNT" || { echo 'Missing existing Firebase service-account secret'; exit 1; }
+          printf '%s' "$FIREBASE_SERVICE_ACCOUNT" > "$GOOGLE_APPLICATION_CREDENTIALS"
+          npx --yes firebase-tools@13.35.1 deploy --only firestore:rules --project com-example-qlct-61329 --non-interactive
+      - name: Deploy Hosting site hnlqltc
+        shell: bash
+        env:
+          FIREBASE_SERVICE_ACCOUNT: ${{ secrets.FIREBASE_SERVICE_ACCOUNT_COM_EXAMPLE_QLCT_61329 }}
+          GOOGLE_APPLICATION_CREDENTIALS: ${{ runner.temp }}/firebase-service-account.json
+        run: |
+          set -euo pipefail
+          printf '%s' "$FIREBASE_SERVICE_ACCOUNT" > "$GOOGLE_APPLICATION_CREDENTIALS"
+          npx --yes firebase-tools@13.35.1 deploy --only hosting --config firebase.prod.json --project com-example-qlct-61329 --non-interactive
+      - name: PROD web smoke test
+        shell: bash
+        run: |
+          set -euo pipefail
+          for i in 1 2 3 4 5; do
+            code=$(curl -L -sS -o /tmp/hnlqltc.html -w '%{http_code}' --max-time 20 "https://hnlqltc.web.app/?release=rc2.2.14&probe=${GITHUB_RUN_ID}-${i}" || true)
+            if [ "$code" = "200" ] && grep -qi '<div id="root"' /tmp/hnlqltc.html; then
+              echo "HNL QLTC PROD smoke PASS on attempt $i"
+              exit 0
+            fi
+            echo "Waiting for Hosting propagation: HTTP=$code attempt=$i"
+            sleep 5
+          done
+          echo 'PROD Hosting smoke failed'
+          exit 1
