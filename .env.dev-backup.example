# HNL QLTC DEV BACKUP - template only; NEVER point at the primary or PROD project.
# Copy to .env.dev-backup.local (ignored by git). SDK config is a public Firebase Web App configuration, NOT an admin credential.
VITE_APP_ENV=DEV
VITE_DEV_FIREBASE_TARGET=backup
VITE_RUNTIME_BACKEND=firebase-only
VITE_FIREBASE_PROJECT_ID=hnl-qltc-dev-backup
VITE_FIREBASE_API_KEY=AIzaSyC3pD9OyZ8My4q2UVB_pJEcE5hT30EGGL0
VITE_FIREBASE_AUTH_DOMAIN=hnl-qltc-dev-backup.firebaseapp.com
VITE_FIREBASE_APP_ID=1:87340841644:web:02c6f832427ddf30cf7d09
VITE_FIREBASE_MESSAGING_SENDER_ID=87340841644
VITE_FIREBASE_STORAGE_BUCKET=hnl-qltc-dev-backup.firebasestorage.app
VITE_FIREBASE_FIRESTORE_DATABASE_ID=(default)
VITE_USE_FIREBASE_EMULATORS=false
# Spark has no Cloud Functions or Firebase Cloud Storage; do not pretend these are ready.
VITE_WAREHOUSE_TRUSTED_WRITER=false
VITE_BINARY_STORAGE_PROVIDER=r2
# Keep empty until a separate, backup-bound R2 Worker is configured and verified.
VITE_R2_GATEWAY_URL=
VITE_HNL_AI_ENABLED=false
VITE_HNL_AI_GATEWAY_URL=
VITE_ENABLE_LEGACY_DRIVE_READ=false
VITE_ENABLE_LEGACY_DRIVE_WRITE=false
VITE_ENABLE_LEGACY_LOCAL_BUSINESS_CACHE_WRITE=false
